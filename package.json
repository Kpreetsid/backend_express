{
  "name": "project_api_javascript",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch --inspect=0.0.0.0:9229 src/server.ts",
    "build": "npx shx rm -rf dist && npx tsc && npx shx mkdir -p dist/public && npx shx cp -r src/public/* dist/public/",
    "start": "node --require ./dist/instrumentation.js dist/server.js",
    "start:worker": "node --require ./dist/instrumentation.js dist/worker.js",
    "outbox:redrive": "tsx scripts/redrive-outbox.ts",
    "uploads:migrate": "tsx scripts/migrate-local-uploads.ts",
    "uploads:quota-reconcile": "tsx scripts/reconcile-upload-quota.ts",
    "migrate:stored-upload-indexes": "tsx scripts/migrate-stored-upload-indexes.ts",
    "migrate:upload-quota-indexes": "tsx scripts/migrate-upload-quota-indexes.ts",
    "migrate:asset-report-pdf-job-indexes": "tsx scripts/migrate-asset-report-pdf-job-indexes.ts",
    "migrate:indexes:production": "node dist/operations/apply-production-indexes.js",
    "test:deployment-smoke": "node --test scripts/smoke-api-deployment.test.cjs scripts/run-with-runtime-secret.test.cjs scripts/validate-release-gates.test.cjs scripts/validate-rollback-authorization.test.cjs",
    "smoke:deployment": "node scripts/smoke-api-deployment.cjs",
    "load:capacity": "node scripts/load/enterprise-capacity.cjs",
    "test:capacity-tooling": "node --test scripts/load/enterprise-capacity.test.cjs",
    "start:build": "npm run build && npm start",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:repository": "vitest run --config vitest.repository-coverage.config.ts --coverage",
    "license:check": "node scripts/check-licenses.cjs",
    "check:lookup-from": "node scripts/check-lookup-from.js",
    "check:api-contract": "node scripts/check-api-contract.js",
    "generate:openapi": "node scripts/check-openapi-contract.js --write",
    "check:openapi": "node scripts/check-openapi-contract.js",
    "generate:response-contracts": "node scripts/check-response-contracts.js --write",
    "check:response-contracts": "node scripts/check-response-contracts.js",
    "generate:index-manifest": "tsx scripts/check-index-manifest.ts --write",
    "check:index-manifest": "tsx scripts/check-index-manifest.ts",
    "check:runtime-boundaries": "node scripts/check-runtime-boundaries.js",
    "check:domain-outbox": "node scripts/check-domain-outbox-boundaries.js",
    "check:enterprise": "npm run typecheck && npm test && npm run test:deployment-smoke && npm run test:capacity-tooling && npm run check:lookup-from && npm run check:api-contract && npm run check:openapi && npm run check:response-contracts && npm run check:index-manifest && npm run check:runtime-boundaries && npm run check:domain-outbox"
  },
  "keywords": [],
  "author": "Pawan Kumar Gautam",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.8.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.4.0",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
