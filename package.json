{
  "name": "cmms-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child --inspect=0.0.0.0:9229 src/server.ts --host 0.0.0.0",
    "build": "npx shx rm -rf dist && npx tsc -p tsconfig.build.json && npx shx mkdir -p dist/public && npx shx cp -r src/public/* dist/public/",
    "start": "npm run build && node dist/server.js",
    "typecheck": "npx tsc --noEmit",
    "test:password-security": "node --require ts-node/register/transpile-only --test src/modules/auth/services/verification-challenge.service.test.ts src/modules/auth/services/verification-mail.test.ts src/modules/auth/services/password-recovery.test.ts src/modules/auth/services/password-flow.test.ts src/modules/auth/services/password-session.test.ts src/modules/auth/services/password-expiry.test.ts",
    "catalog:generate": "node scripts/generate-asset-train-catalog.cjs",
    "catalog:check": "node scripts/generate-asset-train-catalog.cjs --check",
    "test:catalog": "node --require ts-node/register/transpile-only --test src/modules/assets/catalog/asset-train-catalog.test.ts",
    "test:asset-train": "node --require ts-node/register/transpile-only --test src/modules/assets/catalog/asset-train-catalog.test.ts src/modules/assets/services/asset-train-creation.test.ts src/modules/assets/services/asset-component-management.test.ts",
    "test:cmms": "node --require ts-node/register/transpile-only --test src/core/scheduler/scheduler-recurrence.test.ts src/modules/inventory/services/work-order-quantities.test.ts src/modules/work-orders/controllers/request-boundaries.test.ts src/modules/work-orders/services/cmms-regression.test.ts",
    "test": "npm run test:unit && npm run test:regression",
    "test:unit": "vitest run",
    "test:regression": "node scripts/run-regression-tests.cjs"
  },
  "keywords": [],
  "author": "Pawan Kumar Gautam",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "puppeteer": "^25.11.0",
    "socket.io": "^4.8.3",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "@types/sanitize-html": "^2.16.1",
    "vitest": "^5.0.1"
  }
}
