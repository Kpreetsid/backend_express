+  cmmsReport(): void {
+    if (!this.selectedLocId || !this.account_id || this.cmmsReportLoading) {
+      return;
+    }
+
+    const locationId = this.selectedLocId;
+    const payload = {
+      location_ids: [locationId],
+      org_id: this.account_id
+    };
+
+    this.cmmsReportData = null;
+    this.cmmsReportLoading = true;
+
+    this.apiService.postData<{
+      status: boolean;
+      message?: string;
+      data?: Record<string, unknown>;
+    }>('/api/reports/locations/cmms-data', payload).pipe(
+      takeUntil(this.destroy$),
+      finalize(() => { this.cmmsReportLoading = false; })
+    ).subscribe({
+      next: (response) => {
+        if (this.selectedLocId !== locationId) {
+          return;
+        }
+        if (response.status && response.data) {
+          this.cmmsReportData = response.data;
+        } else {
+          this.toaster.error(response.message || 'Unable to fetch the CMMS report.');
+        }
+      },
+      error: (error: any) => {
+        if (this.selectedLocId === locationId) {
+          this.toaster.error(error?.error?.message || error?.message || 'Unable to fetch the CMMS report.');
+        }
       }
     });
   }
