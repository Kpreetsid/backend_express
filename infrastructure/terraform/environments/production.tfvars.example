environment          = "production"
ami_id               = "ami-replace-production"
alb_certificate_arn  = "arn:aws:acm:ap-south-1:000000000000:certificate/replace"
artifact_bucket_name = "replace-cmms-artifacts-production"
upload_bucket_name   = "replace-cmms-uploads-production"
spa_bucket_name      = "replace-cmms-spa-production"
runtime_secret_arns = [
  "arn:aws:secretsmanager:ap-south-1:000000000000:secret:cmms/production/runtime"
]
runtime_secret_kms_key_arns = [
  "arn:aws:kms:ap-south-1:000000000000:key/replace"
]
minimum_instances = 1
desired_instances = 1
maximum_instances = 4

# The production cutover changes minimum/desired to at least two only after
# managed MongoDB, Redis, S3 migration, failover, and rollback evidence pass.
