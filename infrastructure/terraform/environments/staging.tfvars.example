environment          = "staging"
ami_id               = "ami-replace-staging"
alb_certificate_arn  = "arn:aws:acm:ap-south-1:000000000000:certificate/replace"
artifact_bucket_name = "replace-cmms-artifacts-staging"
upload_bucket_name   = "replace-cmms-uploads-staging"
spa_bucket_name      = "replace-cmms-spa-staging"
runtime_secret_arns = [
  "arn:aws:secretsmanager:ap-south-1:000000000000:secret:cmms/staging/runtime"
]
minimum_instances = 1
desired_instances = 1
maximum_instances = 2

# Raise desired_instances only for the documented two-instance proof after
# managed Redis and S3 reconciliation are ready.
