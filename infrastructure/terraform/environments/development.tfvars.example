environment          = "development"
ami_id               = "ami-replace-development"
alb_certificate_arn  = "arn:aws:acm:ap-south-1:000000000000:certificate/replace"
artifact_bucket_name = "replace-cmms-artifacts-development"
upload_bucket_name   = "replace-cmms-uploads-development"
spa_bucket_name      = "replace-cmms-spa-development"
runtime_secret_arns = [
  "arn:aws:secretsmanager:ap-south-1:000000000000:secret:cmms/development/runtime"
]
minimum_instances = 1
desired_instances = 1
maximum_instances = 2

# Supply redis_auth_token through TF_VAR_redis_auth_token or an approved
# encrypted CI secret. Never store it in this file.
